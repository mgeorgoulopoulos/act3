#include "recreated/eggplant_cubemap.h"

@eggplant_grid_defines@

std::vector<d3d9::Matrix> preview::eggplantPlacements()
{
    std::vector<d3d9::Matrix> placements;
    for (int grid = 0; grid < 2; ++grid)
        for (int x = 0; x < NUM_ROWS; ++x)
            for (int z = 0; z < NUM_ROWS; ++z) {
                d3d9::Matrix placement;
                const float offset = grid * EGG_DISTANCE / 2;
                placement.m[3][0] = EGG_DISTANCE * x - EGG_SHIFT + offset;
                placement.m[3][2] = EGG_DISTANCE * z - EGG_SHIFT + offset;
                placements.push_back(placement);
            }
    return placements;
}

d3d9::HRESULT preview::loadEggplantCubemap(d3d9::Device* m_pd3dDevice,
    LPDIRECT3DCUBETEXTURE9& CubeMap)
{
    // The call is taken from Scene1::Init at configure time.
    return @eggplant_cube_call@;
}
